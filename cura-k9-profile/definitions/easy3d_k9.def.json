        "machine_start_gcode": {
            "default_value": "; === K9 Start G-code: Smart Prime + Purge ===\nM302 S0                     ; Disable cold extrusion prevention\nM200 D0                     ; Disable volumetric extrusion\nM83                         ; Relative extrusion mode\nG92 E0                      ; Reset extruder position\n; --- Phase 1: Soft prime ---\nM907 E400                   ; Lower extruder current to 400mA\nM104 S{material_print_temperature_layer_0 * 0.9}   ; Heat to 90%% softening\nM109 S{material_print_temperature_layer_0 * 0.9}   ; Wait for softening\nG91                         ; Relative positioning\nG1 E60 F120                 ; Push 60mm \u2192 stepper skips safely\nG90                         ; Absolute positioning\n; --- Phase 2: Enable extrusion ---\nM907 E800                   ; Restore extruder current to 800mA\nM104 S{material_print_temperature_layer_0}  ; Heat to print temperature\nM109 S{material_print_temperature_layer_0}  ; Wait for print temp\n; --- Phase 3: Volumetric purge ---\nM200 D1.75                  ; Set filament diameter\nM200 S1                     ; Enable volumetric extrusion\nG92 E0                      ; Reset extruder\nG1 Z10 F300                 ; Lift nozzle\nG1 X15 Y15 F600             ; Move to purge start\nG1 Z0.12 F300               ; Lower to 0.12mm\nG1 X65 Y15 E60 F180         ; Purge \u2192 50mm @ 3mm/s\nG1 X65 Y20 F300             ; Offset\nG1 X15 Y20 E48 F120         ; Purge \u2190 50mm @ 2mm/s\nG92 E0                      ; Reset extruder\nG1 Z5 F300                  ; Lift nozzle\n"
        },
        "machine_end_gcode": {
            "default_value": "; K9 End G-code\nG91                     ; Relative positioning\nG1 Z10 F300             ; Lift clear of print\nG90                     ; Absolute positioning\nG1 X0 Y{machine_depth} F900  ; Park back-left\nM104 S0                 ; Hotend off\nM107                    ; Fan off\nM84 X Y E               ; Disable steppers\n"
