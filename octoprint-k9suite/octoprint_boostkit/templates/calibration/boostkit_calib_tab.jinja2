<div id="tab_plugin_boostkit_calib" class="bkcalib">
    <!-- Banner de capacidades -->
    <div class="bkcal-topbar">
        <div class="bkcal-caps" data-bind="text: capsBanner, visible: caps()"></div>
    </div>
    <div class="bkcal-msg" data-bind="text: lastMsg, visible: lastMsg()"></div>

    <div class="row-fluid">
        <!-- Selector de tests -->
        <div class="span3 bkcal-picker" data-bind="foreach: TESTS">
            <button class="btn bkcal-test" data-bind="click: $parent.selectTest,
                    css: { active: $parent.activeTest() === id }">
                <i class="fas" data-bind="css: 'fa-' + icon"></i> <span data-bind="text: name"></span>
            </button>
        </div>

        <!-- Panel del test activo -->
        <div class="span9 bkcal-panel">
            <h4 data-bind="text: activeMeta() ? activeMeta().name : ''"></h4>
            <p class="muted" data-bind="text: activeMeta() && activeMeta().help, visible: activeMeta() && activeMeta().help"></p>

            <!-- ===== Patrón: ecualizador + preview ===== -->
            <div data-bind="visible: isPattern">
                <div class="bkcal-pattern">
                    <div class="bkcal-ptable">
                        <div class="bkcal-phead">
                            <span class="bkcal-plabel">Parámetro</span>
                            <span class="bkcal-pvarycol">variar</span>
                            <span class="bkcal-pvalcol">valor / rango (inicio · fin · paso)</span>
                        </div>
                        <!-- ko foreach: params -->
                        <div class="bkcal-prow" data-bind="css: {'bkcal-prow-var': canVary && vary()}">
                            <span class="bkcal-plabel"><span data-bind="text: label"></span>
                                <small data-bind="text: u"></small></span>
                            <span class="bkcal-pvarycol">
                                <input type="checkbox" data-bind="checked: vary, enable: canVary">
                            </span>
                            <span class="bkcal-pvalcol">
                                <!-- FIJO -->
                                <input type="number" class="input-mini" data-bind="visible: !(canVary && vary()),
                                       value: val, attr: { min: min, max: max, step: step }">
                                <!-- VARIADO: inicio / fin / paso + nº de valores -->
                                <span class="bkcal-prange" data-bind="visible: canVary && vary()">
                                    <input type="number" class="input-mini" title="inicio" data-bind="value: vstart, attr: { min: min, max: max, step: step }">
                                    <span class="bkcal-psep">·</span>
                                    <input type="number" class="input-mini" title="fin" data-bind="value: vend, attr: { min: min, max: max, step: step }">
                                    <span class="bkcal-psep">·</span>
                                    <input type="number" class="input-mini" title="paso" data-bind="value: vstep, attr: { step: step }">
                                    <span class="bkcal-pn" data-bind="text: '×' + nvalues()"></span>
                                </span>
                            </span>
                        </div>
                        <!-- /ko -->
                        <div class="bkcal-count">
                            <span><i class="fas fa-th"></i> Especímenes: <strong data-bind="text: specimenCount"></strong></span>
                            <span data-bind="visible: tempBands() > 1"> · bandas de temp: <strong data-bind="text: tempBands"></strong></span>
                            <span class="bkcal-overflow" data-bind="visible: overflow">
                                <i class="fas fa-exclamation-triangle"></i> no caben en la cama — reduce rango/paso o tamaño</span>
                        </div>
                    </div>
                    <!-- Preview ISOMÉTRICO 3D (render en el cliente, color por altura). Posición
                         FIJA (columna derecha) para que no se reacomode al cambiar de test. -->
                    <div class="bkcal-preview">
                        <div class="bkcal-prev-title">Vista previa 3D</div>
                        <canvas id="bkcal-canvas" width="200" height="200"></canvas>
                        <div class="bkcal-prev-msg">
                            <span data-bind="visible: previewBusy"><i class="fas fa-spinner fa-spin"></i> renderizando…</span>
                            <span class="bkcal-prev-err" data-bind="text: previewErr, visible: previewErr()"></span>
                        </div>
                        <button class="bkcal-btn bkcal-btn-mini" data-bind="click: view3d"
                                title="Cargar este test en el Enhanced Viewer (3D completo)">
                            <i class="fas fa-cube"></i> Ver en 3D</button>
                    </div>
                </div>

                <div class="bkcal-presets">
                    <span class="muted small">Presets:</span>
                    <!-- ko foreach: currentPresets -->
                    <span class="bkcal-preset">
                        <button class="bkcal-btn bkcal-btn-mini" data-bind="text: name, click: $parent.loadPreset"></button>
                        <a class="bkcal-preset-x" data-bind="click: $parent.deletePreset" title="Borrar">×</a>
                    </span>
                    <!-- /ko -->
                    <input type="text" class="input-mini" placeholder="nombre" data-bind="value: presetName">
                    <button class="bkcal-btn bkcal-btn-mini" data-bind="click: savePreset"><i class="fas fa-save"></i></button>
                </div>

                <div class="bkcal-actions">
                    <button class="bkcal-btn" data-bind="click: function(){ generate(false); }">
                        <i class="fas fa-file-code"></i> Generar gcode</button>
                    <button class="bkcal-btn bkcal-btn-primary" data-bind="click: function(){ generate(true); },
                            enable: printerState.isOperational() && !printerState.isPrinting()">
                        <i class="fas fa-print"></i> Generar e imprimir</button>
                    <button class="bkcal-btn" data-bind="click: toggleEditor, css: {'bkcal-btn-primary': editOpen}">
                        <i class="fas fa-code"></i> Editar gcode</button>
                    <button class="bkcal-btn" data-bind="click: duplicateTest"><i class="fas fa-clone"></i> Duplicar</button>
                    <button class="bkcal-btn bkcal-btn-danger" data-bind="click: deleteTest"><i class="fas fa-trash"></i></button>
                </div>

                <!-- ===== Editor de test (plantilla Jinja + esquema params) ===== -->
                <div class="bkcal-editor" data-bind="visible: editOpen">
                    <div class="bkcal-ed-row">
                        <label>id <input type="text" class="input-small" data-bind="value: editId"></label>
                        <label>nombre <input type="text" class="input-medium" data-bind="value: editName"></label>
                    </div>
                    <label class="bkcal-ed-lbl">Plantilla Jinja (contexto: <code>g</code>, <code>params</code>, <code>caps</code>, <code>frange</code>, <code>builtin()</code>)</label>
                    <textarea class="bkcal-ed-tpl" rows="10" data-bind="value: editTemplate, valueUpdate: 'afterkeydown'"></textarea>
                    <label class="bkcal-ed-lbl">Esquema de parámetros (JSON)</label>
                    <textarea class="bkcal-ed-params" rows="4" data-bind="value: editParamsJson"></textarea>
                    <div class="bkcal-actions">
                        <button class="bkcal-btn" data-bind="click: tryTemplate"><i class="fas fa-eye"></i> Probar (preview)</button>
                        <button class="bkcal-btn bkcal-btn-primary" data-bind="click: saveTest"><i class="fas fa-save"></i> Guardar test</button>
                    </div>
                </div>
            </div>

            <!-- ===== PID autotune ===== -->
            <div data-bind="visible: isPid">
                <div class="bkcal-fields">
                    <label class="bkcal-field"><span>Calentador</span>
                        <select data-bind="value: pidHeater">
                            <option value="hotend">Hotend</option>
                            <option value="bed">Cama</option>
                        </select></label>
                    <label class="bkcal-field"><span>Ciclos</span><input type="number" class="input-mini" min="3" max="20" data-bind="value: pidCycles"></label>
                    <label class="bkcal-field"><span>Temp</span><input type="number" class="input-mini" data-bind="value: pidTemp"><small>°C</small></label>
                    <label class="bkcal-field"><span>Fan</span><input type="number" class="input-mini" min="0" max="255" data-bind="value: pidFan"></label>
                </div>
                <div class="bkcal-actions">
                    <button class="bkcal-btn bkcal-btn-primary" data-bind="click: function(){ runPid(false); },
                            enable: printerState.isOperational() && !pidBusy()">
                        <i class="fas fa-play"></i> Ejecutar</button>
                    <button class="bkcal-btn" data-bind="click: function(){ runPid(true); },
                            enable: printerState.isOperational() && !pidBusy()">
                        <i class="fas fa-save"></i> Ejecutar + guardar (M500)</button>
                    <span class="bkcal-spinner" data-bind="visible: pidBusy"><i class="fas fa-spinner fa-spin"></i> calculando…</span>
                </div>
                <div class="bkcal-pid-res" data-bind="visible: pidResult">
                    Resultado: <strong>P</strong> <span data-bind="text: pidResult() && pidResult().p"></span>
                    <strong>I</strong> <span data-bind="text: pidResult() && pidResult().i"></span>
                    <strong>D</strong> <span data-bind="text: pidResult() && pidResult().d"></span>
                </div>
            </div>

            <!-- ===== E-steps (pasos numerados, campos alineados) ===== -->
            <div class="bkcal-esteps" data-bind="visible: isEsteps">
                <div class="bkcal-estep">
                    <span class="bkcal-estep-n">1</span>
                    <div class="bkcal-estep-body">
                        <button class="bkcal-btn bkcal-btn-mini" data-bind="click: esReadCurrent"><i class="fas fa-download"></i> Leer M92 actual</button>
                        <span class="bkcal-estep-out">E actual: <strong data-bind="text: esCurrent() != null ? esCurrent() : '—'"></strong></span>
                    </div>
                </div>
                <div class="bkcal-estep">
                    <span class="bkcal-estep-n">2</span>
                    <div class="bkcal-estep-body">
                        <span class="bkcal-estep-txt">Marca una referencia en el filamento, calienta y extruye una longitud conocida:</span>
                        <div class="bkcal-fields">
                            <label class="bkcal-field"><span>Marca</span><input type="number" class="input-mini" data-bind="value: esMark"><small>mm</small></label>
                            <label class="bkcal-field"><span>T</span><input type="number" class="input-mini" data-bind="value: esTemp"><small>°C</small></label>
                            <label class="bkcal-field"><span>Extruir</span><input type="number" class="input-mini" data-bind="value: esLength"><small>mm</small></label>
                            <label class="bkcal-field"><span>Vel.</span><input type="number" class="input-mini" data-bind="value: esSpeed"><small>mm/s</small></label>
                        </div>
                        <button class="bkcal-btn bkcal-btn-mini bkcal-btn-primary" data-bind="click: esExtrude,
                                enable: printerState.isOperational()"><i class="fas fa-play"></i> Extruir</button>
                    </div>
                </div>
                <div class="bkcal-estep">
                    <span class="bkcal-estep-n">3</span>
                    <div class="bkcal-estep-body">
                        <span class="bkcal-estep-txt">Mide el filamento que queda hasta la marca:</span>
                        <label class="bkcal-field"><span>Sobrante</span><input type="number" class="input-mini" data-bind="value: esRemained"><small>mm</small></label>
                        <span class="bkcal-estep-out">nuevo E: <strong data-bind="text: esNew() != null ? esNew() : '—'"></strong></span>
                    </div>
                </div>
                <div class="bkcal-estep">
                    <span class="bkcal-estep-n">4</span>
                    <div class="bkcal-estep-body">
                        <button class="bkcal-btn bkcal-btn-mini" data-bind="click: function(){ esApply(false); }, enable: esNew()"><i class="fas fa-check"></i> Aplicar (M92)</button>
                        <button class="bkcal-btn bkcal-btn-mini" data-bind="click: function(){ esApply(true); }, enable: esNew()"><i class="fas fa-save"></i> Aplicar + guardar (M500)</button>
                    </div>
                </div>
            </div>

            <!-- ===== Backlash probe (G38.2 + M425) ===== -->
            <div class="bkcal-backlash" data-bind="visible: isBacklashProbe">
                <div class="bkcal-fields">
                    <label class="bkcal-field"><span>Eje</span>
                        <select data-bind="value: blAxis">
                            <option value="x">X</option>
                            <option value="y">Y</option>
                            <option value="z">Z</option>
                        </select>
                    </label>
                    <label class="bkcal-field"><span>M425 inicio</span>
                        <input type="number" step="0.01" class="input-mini" data-bind="value: blM425Start"><small>mm</small>
                    </label>
                    <label class="bkcal-field"><span>M425 fin</span>
                        <input type="number" step="0.01" class="input-mini" data-bind="value: blM425End"><small>mm</small>
                    </label>
                    <label class="bkcal-field"><span>M425 paso</span>
                        <input type="number" step="0.01" class="input-mini" data-bind="value: blM425Step"><small>mm</small>
                    </label>
                    <label class="bkcal-field"><span>Pos ref (safe)</span>
                        <input type="number" step="0.5" class="input-mini" data-bind="value: blRefPos"><small>mm</small>
                    </label>
                    <label class="bkcal-field" title="Coordenada objetivo del G1 lento del sondeo. El endstop físico debe interceptar antes de que el cabezal llegue aquí. Con soft endstops desactivados durante el barrido, puede ser negativo (p.ej. -5).">
                        <span>Target sondeo</span>
                        <input type="number" step="0.5" class="input-mini" data-bind="value: blTarget"><small>mm</small>
                    </label>
                    <label class="bkcal-field" title="Velocidad del G1 hacia el endstop. Lento (200-400) da mejor precisión de disparo; rápido acelera el barrido pero puede sobrepasar.">
                        <span>Feed sondeo</span>
                        <input type="number" step="10" class="input-mini" data-bind="value: blFeed"><small>mm/min</small>
                    </label>
                    <label class="bkcal-field"><span>Muestras/valor</span>
                        <input type="number" min="1" max="10" class="input-mini" data-bind="value: blSamplesPer">
                    </label>
                </div>
                <div class="bkcal-actions">
                    <button class="bkcal-btn bkcal-btn-primary"
                            data-bind="click: runBacklashSweep, enable: printerState.isOperational() && !printerState.isPrinting() && !blBusy()">
                        <i class="fas fa-play"></i> Barrer M425
                    </button>
                    <button class="bkcal-btn" data-bind="click: cancelBacklashSweep, visible: blBusy">
                        <i class="fas fa-stop"></i> Cancelar
                    </button>
                </div>
                <table class="bkcal-bl-table" data-bind="visible: blSamples().length">
                    <thead><tr><th>M425 (mm)</th><th>Error medio (mm)</th></tr></thead>
                    <tbody data-bind="foreach: blSamples">
                        <tr data-bind="css: { 'bkcal-pass': $parent.blBest() != null && Math.abs($parent.blBest() - m425) < 1e-6 }">
                            <td data-bind="text: m425.toFixed(3)"></td>
                            <td data-bind="text: error.toFixed(4)"></td>
                        </tr>
                    </tbody>
                </table>
                <div class="bkcal-bl-result" data-bind="visible: blBest() != null">
                    Mejor M425: <strong data-bind="text: blBest() != null ? blBest().toFixed(3) : ''"></strong> mm
                    (err <span data-bind="text: blBestErr() != null ? blBestErr().toFixed(4) : ''"></span> mm)
                    <button class="bkcal-btn" data-bind="click: applyBestBacklash">
                        <i class="fas fa-check"></i> Aplicar M425
                    </button>
                    <button class="bkcal-btn bkcal-btn-primary" data-bind="click: applyBestBacklashSave">
                        <i class="fas fa-save"></i> Aplicar + M500
                    </button>
                </div>
            </div>

            <!-- ===== Nivelación de cama ===== -->
            <div class="bklvl" data-bind="visible: isLeveling">
                <div class="bkcal-caps"><b>Nivelación</b> · <span data-bind="text: lvCapsInfo"></span> · plato <span data-bind="text: lvW"></span>×<span data-bind="text: lvH"></span></div>

                <div class="bklvl-modetoggle">
                    <button class="bkcal-btn" data-bind="css: { 'bkcal-btn-primary': !isManual() }, click: function () { setMode('auto'); }"><i class="fas fa-ruler-vertical"></i> Automática (sonda)</button>
                    <button class="bkcal-btn" data-bind="css: { 'bkcal-btn-primary': isManual() }, click: function () { setMode('manual'); }"><i class="fas fa-hand-pointer"></i> Editor manual</button>
                </div>

                <div class="bklvl-cols">
                    <div class="bklvl-map">
                        <div class="bkcal-prev-title">Superficie a sondear — <span class="muted" data-bind="text: lvCoverage"></span></div>
                        <div class="bklvl-cvwrap"><canvas id="bklvl-bed" width="700" height="600"></canvas></div>
                        <div class="bklvl-legend">
                            <span><i class="bklvl-sw plate"></i> plato</span>
                            <span><i class="bklvl-sw probe"></i> punto de sondeo</span>
                            <span><i class="bklvl-sw nin"></i> nodo medido</span>
                            <span><i class="bklvl-sw nout"></i> nodo extrapolado</span>
                        </div>
                    </div>
                    <div class="bklvl-cfg" data-bind="visible: !isManual()">
                        <div class="bklvl-shead">Rectángulo del plato <small>coords máquina</small></div>
                        <div class="bkcal-fields">
                            <label class="bkcal-field"><span>X0</span><input type="number" class="input-mini" data-bind="value: lvX0"><small>mm</small></label>
                            <label class="bkcal-field"><span>Y0</span><input type="number" class="input-mini" data-bind="value: lvY0"><small>mm</small></label>
                        </div>
                        <div class="bkcal-fields">
                            <label class="bkcal-field"><span>Ancho</span><input type="number" class="input-mini" data-bind="value: lvW"><small>mm</small></label>
                            <label class="bkcal-field"><span>Alto</span><input type="number" class="input-mini" data-bind="value: lvH"><small>mm</small></label>
                            <label class="bkcal-field"><span>Inset</span><input type="number" class="input-mini" data-bind="value: lvInset"><small>mm</small></label>
                        </div>
                        <div class="bklvl-shead">Puntos y modelo</div>
                        <div class="bkcal-fields">
                            <label class="bkcal-field"><span>Rejilla</span><input type="number" class="input-mini" min="2" max="6" data-bind="value: lvGridN"><small data-bind="text: lvGridLabel"></small></label>
                            <label class="bkcal-field"><span>Medidas</span><input type="number" class="input-mini" min="1" max="4" data-bind="value: lvReps"></label>
                            <label class="bkcal-field" title="Altura a la que se levanta la sonda entre puntos (la sonda de brazo manual cuelga y arrastra si es poca).">
                                <span>Despegue</span><input type="number" class="input-mini" min="1" step="0.5" data-bind="value: lvClearance"><small>mm</small></label>
                        </div>
                        <div class="bkcal-fields">
                            <label class="bkcal-field"><span>Modelo</span>
                                <select data-bind="value: lvModel"><option value="plane">Plano (cristal)</option><option value="warp">Con alabeo</option></select></label>
                            <label class="bkcal-field"><span>Método</span>
                                <select data-bind="value: lvMethod"><option value="g30_plate">G30 (plato)</option><option value="g29">G29 (cama)</option></select></label>
                        </div>
                        <p class="muted small" data-bind="text: lvModelNote"></p>
                        <label class="bkcal-field" data-bind="visible: lvCaps().backlash"
                               title="Setea el backlash de Z medido durante el sondeo (M425 Z + M425 F1.0). Solo si el firmware lo soporta; persiste al guardar la malla.">
                            <input type="checkbox" data-bind="checked: lvApplyBacklash"> <span>Aplicar backlash Z</span></label>
                        <div class="bklvl-shead">Robustez <small>ruido, pegamento e inclinación</small></div>
                        <label class="bkcal-field"
                               title="Descarta lecturas anómalas (bultos de pegamento) al ajustar el plano, para no re-limpiar el cristal cada vez.">
                            <input type="checkbox" data-bind="checked: lvRobust"> <span>Rechazar bultos (plano limpio)</span></label>
                        <div class="bkcal-fields" data-bind="visible: lvRobust">
                            <label class="bkcal-field" title="Umbral de rechazo = k · MAD. Menor = más estricto.">
                                <span>Rechazo k</span><input type="number" class="input-mini" min="1" max="6" step="0.5" data-bind="value: lvRejectK"></label>
                            <label class="bkcal-field" title="Techo duro: una lectura que se desvíe más que esto SIEMPRE se descarta.">
                                <span>Techo</span><input type="number" class="input-mini" min="0.1" step="0.05" data-bind="value: lvCeiling"><small>mm</small></label>
                            <label class="bkcal-field" title="Reintentos bajando el piso de sondeo (M851) ante un fallo de sonda en inclinación severa.">
                                <span>Reintentos</span><input type="number" class="input-mini" min="0" max="4" data-bind="value: lvProbeRetries"></label>
                        </div>
                    </div>

                    <!-- Editor manual (sin sonda) -->
                    <div class="bklvl-cfg" data-bind="visible: isManual">
                        <div class="bklvl-shead">Editor manual <small>click en un nodo del mapa</small></div>
                        <p class="muted small">Nivelación manual sin sonda: elige un nodo, ve a él, baja Z hasta que roce una hoja y fija. Requiere Z homeada; la compensación se desactiva mientras editas.</p>
                        <div class="bkcal-fields">
                            <span class="bkcal-field"><span>Nodo</span> <strong data-bind="text: lvSelLabel"></strong></span>
                            <span class="bkcal-field"><span>Z nodo</span> <strong data-bind="text: lvSelZ() != null ? lvSelZ().toFixed(3) + ' mm' : '—'"></strong></span>
                        </div>
                        <div class="bklvl-editbtns">
                            <button class="bkcal-btn" data-bind="click: gotoNode, enable: lvSel() && printerState.isOperational()"><i class="fas fa-crosshairs"></i> Ir al punto</button>
                        </div>
                        <div class="bkcal-fields">
                            <label class="bkcal-field"><span>Paso Z</span>
                                <select data-bind="value: lvZStep"><option value="0.05">0.05</option><option value="0.01">0.01</option><option value="0.1">0.1</option></select><small>mm</small></label>
                            <button class="bkcal-btn" data-bind="click: function () { jogZ(1); }, enable: printerState.isOperational()"><i class="fas fa-arrow-up"></i> +Z</button>
                            <button class="bkcal-btn" data-bind="click: function () { jogZ(-1); }, enable: printerState.isOperational()"><i class="fas fa-arrow-down"></i> −Z</button>
                        </div>
                        <div class="bklvl-editbtns">
                            <button class="bkcal-btn bkcal-btn-primary" data-bind="click: fixNode, enable: lvSel() && printerState.isOperational()"><i class="fas fa-check"></i> Fijar nodo (M421)</button>
                        </div>
                    </div>
                </div>

                <div class="bklvl-run" data-bind="visible: !isManual()">
                    <button class="bkcal-btn bkcal-btn-primary" data-bind="click: startLevel, enable: printerState.isOperational() && !lvRunning()">
                        <i class="fas fa-layer-group"></i> Desplegar sonda y nivelar</button>
                    <button class="bkcal-btn" data-bind="click: cancelLevel, visible: lvRunning"><i class="fas fa-stop"></i> Cancelar</button>
                    <span class="bklvl-badge">desatendido · auto-M108</span>
                    <div class="bklvl-bar"><i data-bind="style: { width: lvProgress() + '%' }"></i></div>
                    <span class="muted small" data-bind="text: lvStatus() + (lvDetail() ? ' · ' + lvDetail() : '')"></span>
                </div>

                <div class="bklvl-cols">
                    <div class="bklvl-map">
                        <div class="bkcal-prev-title">Topografía — <span class="muted" data-bind="text: meshInfo"></span></div>
                        <div class="bklvl-cvwrap"><canvas id="bkmesh_canvas" width="560" height="360"></canvas></div>
                        <div class="muted small" data-bind="visible: lvFit" style="margin-top:5px;">
                            Ajuste: <strong data-bind="text: lvFitInfo"></strong>
                            <span data-bind="visible: lvFit() && lvFit().rejected" style="color:var(--bk-danger, #e74c3c);"> (marcados en rojo en el mapa)</span>
                        </div>
                        <div class="muted small" data-bind="visible: lvBacklash" style="margin-top:5px;">
                            Backlash Z: <strong data-bind="text: lvBacklash() ? lvBacklash().z.toFixed(3) : '—'"></strong> mm
                            <span data-bind="visible: lvBacklash() && lvBacklash().applied" style="color:var(--bk-success);">· aplicado (M425 F1.0)</span>
                            <span data-bind="visible: lvBacklash() && !lvBacklash().applied">· sin aplicar</span>
                        </div>
                    </div>
                    <div class="bklvl-cfg">
                        <div class="bklvl-shead">Slots de malla <small data-bind="text: slotsSummary"></small></div>
                        <div class="bklvl-slots" data-bind="foreach: slots">
                            <div class="bklvl-slot" data-bind="css: { filled: filled }">
                                <span class="bklvl-slot-n" data-bind="text: '#' + idx"></span>
                                <span class="bklvl-slot-name" data-bind="text: filled ? (name || ('malla ' + n + '×' + n)) : 'vacío'"></span>
                                <button class="bkcal-btn bkcal-btn-mini" data-bind="click: function () { $parent.activateSlot(idx); }, enable: filled">Activar</button>
                                <button class="bkcal-btn bkcal-btn-mini" data-bind="click: function () { $parent.clearSlot(idx); }, visible: filled"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        <div class="bkcal-fields" style="margin-top:8px;">
                            <label class="bkcal-field"><span>Guardar en</span>
                                <select data-bind="options: slots, optionsText: function (s) { return '#' + s.idx; }, optionsValue: 'idx', value: selSlot"></select></label>
                            <input type="text" class="input-medium" placeholder="nombre" data-bind="value: saveName">
                            <button class="bkcal-btn bkcal-btn-primary" data-bind="click: saveMesh"><i class="fas fa-save"></i> Guardar</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- ===== Tramado manual (papel) ===== -->
            <div class="bktram">
                <div class="bklvl-shead">Tramado manual (papel) <small>wizard guiado sin sonda Z</small></div>
                <p class="muted small">Nivela la cama con una hoja de papel: ve a cada esquina, baja Z hasta que la hoja roce, registra y guarda la malla. La compensación se desactiva durante el proceso.</p>
                <button class="btn btn-primary bk-tram-start" data-bind="click: tramStart, enable: !tramActive(), visible: !tramActive()">Iniciar tramado manual</button>
                <div class="bktram-panel" data-bind="visible: tramActive">
                    <div class="bktram-corners">
                        <button class="btn bk-tram-corner" data-bind="click: function(){ tramGoCorner(0) }, css: { 'bk-tram-active': tramCorner() === 0 }">FL</button>
                        <button class="btn bk-tram-corner" data-bind="click: function(){ tramGoCorner(1) }, css: { 'bk-tram-active': tramCorner() === 1 }">FR</button>
                        <button class="btn bk-tram-corner" data-bind="click: function(){ tramGoCorner(2) }, css: { 'bk-tram-active': tramCorner() === 2 }">BL</button>
                        <button class="btn bk-tram-corner" data-bind="click: function(){ tramGoCorner(3) }, css: { 'bk-tram-active': tramCorner() === 3 }">BR</button>
                    </div>
                    <div class="bktram-zctrl">
                        <button class="btn bk-tram-zbtn" data-bind="click: function(){ tramZJog(-1) }"><i class="fas fa-arrow-down"></i></button>
                        <span class="bktram-step" data-bind="text: 'Paso: ' + tramStepZ() + ' mm'"></span>
                        <input type="number" class="input-mini" step="0.01" min="0.01" data-bind="value: tramStepZ">
                        <button class="btn bk-tram-zbtn" data-bind="click: function(){ tramZJog(1) }"><i class="fas fa-arrow-up"></i></button>
                        <button class="btn bk-tram-register" data-bind="click: tramRegister">Registrar Z</button>
                    </div>
                    <div class="bktram-results">
                        <div class="bktram-res"><span class="bktram-res-label">FL</span><strong data-bind="text: tramResults()[0] != null ? tramResults()[0].toFixed(3) + ' mm' : '—'"></strong></div>
                        <div class="bktram-res"><span class="bktram-res-label">FR</span><strong data-bind="text: tramResults()[1] != null ? tramResults()[1].toFixed(3) + ' mm' : '—'"></strong></div>
                        <div class="bktram-res"><span class="bktram-res-label">BL</span><strong data-bind="text: tramResults()[2] != null ? tramResults()[2].toFixed(3) + ' mm' : '—'"></strong></div>
                        <div class="bktram-res"><span class="bktram-res-label">BR</span><strong data-bind="text: tramResults()[3] != null ? tramResults()[3].toFixed(3) + ' mm' : '—'"></strong></div>
                    </div>
                    <label class="bkcal-field"><span>Grosor papel (mm)</span>
                        <input type="number" class="input-mini" step="0.01" min="0" data-bind="value: tramPaper"></label>
                    <div class="bkcal-actions">
                        <button class="btn btn-success bk-tram-save" data-bind="click: tramSave, enable: tramResults().every(function(z){ return z != null; })">Guardar malla</button>
                        <button class="btn btn-warning bk-tram-cancel" data-bind="click: tramCancel">Cancelar</button>
                    </div>
                    <div class="bk-tram-status" data-bind="text: tramStatus"></div>
                </div>
            </div>

            <!-- ===== Historial / tracking ===== -->
            <div class="bkcal-history" data-bind="visible: history().length">
                <h5>Historial de tests</h5>
                <table class="bkcal-htable">
                    <tbody data-bind="foreach: history">
                        <tr data-bind="css: { 'bkcal-pass': result === 'pass', 'bkcal-fail': result === 'fail' }">
                            <td data-bind="text: test"></td>
                            <td class="bkcal-hparams" data-bind="text: $parent.histSummary($data)"></td>
                            <td class="bkcal-hres" data-bind="text: result"></td>
                            <td>
                                <a class="bkcal-mark ok" data-bind="click: function(){ $parent.markResult($data,'pass'); }" title="Pasó">✓</a>
                                <a class="bkcal-mark no" data-bind="click: function(){ $parent.markResult($data,'fail'); }" title="Falló">✗</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
